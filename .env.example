# Gratuito: Groq - chave criada em console.groq.com/keys (sem cartao de credito)
LLM_API_KEY=sua_chave_aqui
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Outras opcoes (confira os limites gratuitos atuais de cada provedor):
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   Claude (pago): https://api.anthropic.com/v1/ com claude-sonnet-5-5
# true mantem o contexto ML; false permite avaliar a analise sem esse contexto.
LLM_INCLUDE_ML_CONTEXT=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
